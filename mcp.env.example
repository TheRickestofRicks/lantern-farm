# Copy this file to mcp.env in the same folder (mcp.env is gitignored).
# Used only by the optional streamable HTTP transport:
#   python3 mcp_server.py --http
# The token is never printed or logged. Bind is always 127.0.0.1.
#
# LANTERN_FARM_MCP_TOKEN=generate-a-long-random-string
# LANTERN_FARM_MCP_PORT=8791
